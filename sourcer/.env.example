# === Telegram (Telethon) ===
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION_NAME=sourcer_session
TELEGRAM_PHONE=+1234567890

# === LinkedIn scraping (Apify) & outreach (Playwright) ===
APIFY_API_KEY=your_apify_key
APIFY_LINKEDIN_ACTOR=harvestapi/linkedin-profile-search

# LinkedIn cookie — used by Playwright sender AND Voyager inbox poller
LINKEDIN_LI_AT=your_li_at_cookie
LINKEDIN_SALES_NAV_COOKIE=

# Playwright LinkedIn sender behaviour
LI_HEADLESS=true                # set to false to see the browser window (debug)
LI_SEND_MIN_DELAY=300           # minimum seconds between LinkedIn sends (5 min)
LI_SEND_MAX_DELAY=900           # maximum seconds between LinkedIn sends (15 min)

# [DEPRECATED — no longer used] PhantomBuster fields kept for backward compat
PHANTOMBUSTER_API_KEY=
PHANTOMBUSTER_AGENT_ID=
PB_MESSAGE_AGENT_ID=

# Operator alert: your own Telegram @username to receive agent failure pings
OPERATOR_TELEGRAM_USERNAME=@your_username

# === Supabase ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# === Google Gemini ===
GEMINI_API_KEY=your_gemini_key
GEMINI_API_KEYS=key1,key2,key3  # optional comma-separated list for key rotation
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# === Redis / Celery ===
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# === Optional enrichment ===
APOLLO_API_KEY=
HUNTER_API_KEY=
ENABLE_APOLLO=false
ENABLE_HUNTER=false

# === App ===
APP_ENV=dev
API_PORT=8000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO

# === Scoring thresholds ===
EMBEDDING_FILTER_PERCENTILE=0.30
MIN_GEMINI_SCORE=50

# === Auth (JWT multi-tenancy) ===
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080         # 7 days
